{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "schedule": ["* 3,15 * * *"],
  "extends": [
    "config:recommended",
    "group:recommended"
  ],
  "lockFileMaintenance": { "enabled": true },
  "pruneStaleBranches": false,
  "ignoreDeps": ["python"],
  "packageRules": [
    {
      "matchPackageNames": [
        "*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCategories": [
        "python"
      ],
      "groupName": "all non-major python dependencies",
      "groupSlug": "all-minor-patch-python"
    }
  ]
}
